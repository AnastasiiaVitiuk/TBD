# Google Gemini API Key (Gemini 3.8 Live / Gemini 4-argon / Flash)
# Get from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=

# MongoDB Atlas Connection String (for SNOMED CT Vector Search & Visits storage)
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/clinibridge?retryWrites=true&w=majority
MONGODB_URI=

# Optional Voyage AI API key for embeddings
VOYAGE_API_KEY=

# Server Port (default: 5001)
PORT=5001
