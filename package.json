{
  "name": "clinibridge-mobile",
  "version": "1.0.0",
  "description": "Multilingual Clinical Triage & SNOMED CT Grounding Mobile App for NHS Patients and Clinicians",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "server": "tsx watch server/index.ts",
    "dev": "concurrently -n \"SERVER,EXPO\" -c \"cyan,magenta\" \"tsx watch server/index.ts\" \"expo start\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@google/genai": "^2.31.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "expo": "~58.0.19",
    "expo-font": "~58.0.10",
    "expo-speech": "~58.0.3",
    "expo-status-bar": "~58.0.4",
    "express": "^4.21.2",
    "mongodb": "^6.13.0",
    "react": "19.3.0",
    "react-native": "0.88.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "~19.3.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "~6.0.3"
  },
  "private": true
}
